# ── MedusaRust Admin — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to source control.

# URL of the MedusaRust API (Rust backend).
# In development this is usually http://localhost:9000.
# In production replace with your public API domain.
NEXT_PUBLIC_API_URL=http://localhost:9000

# Internal API URL used by the Next.js server process for server-side rewrite proxying.
# Set this to the API hostname within your Docker / Kubernetes network.
# Falls back to NEXT_PUBLIC_API_URL when not set.
# INTERNAL_API_URL=http://app:9000

# Base path when the panel is served under a sub-directory (e.g. /admin).
# Leave empty to serve at the root path.
# NEXT_PUBLIC_BASE_PATH=/admin

# Port the dev server (or `next start`) listens on.
# PORT=7001
