# ─────────────────────────────────────────────────────────────────────────────
# MedusaRust — environment variables
# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_rust

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9000

# ── Object storage ─────────────────────────────────────────────────────────────
#
# MinIO (self-hosted, default for local development)
# ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9002        # MinIO S3 API (see docker-compose.yml)
S3_BUCKET=medusa-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true                 # Required for MinIO; set false for AWS S3
# URL prefix used in asset URLs returned by the API:
S3_PUBLIC_URL=http://localhost:9002/medusa-uploads

# AWS S3 (production)
# ──────────────────
# Uncomment and fill in to switch from MinIO to native AWS S3.
# Remove S3_ENDPOINT and set S3_FORCE_PATH_STYLE=false.
#
# S3_ENDPOINT=                           # leave empty for AWS
# S3_BUCKET=my-medusa-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL=https://my-medusa-bucket.s3.us-east-1.amazonaws.com

# ── Cache (Moka in-process) ───────────────────────────────────────────────────
MOKA_MAX_CAPACITY=10000    # max number of cache entries
MOKA_TTL_SECS=300          # time-to-live in seconds (5 min default)

# ── File upload (local fallback, not used when S3 is configured) ───────────────
UPLOAD_DIR=uploads
